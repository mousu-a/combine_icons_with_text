section.guide-card
  .mb-5
    p.step-label 次のステップ
    h2.mb-2.text-2xl.font-bold.text-gray-900 各サービスでアイコンを変更する
    p.text-base.leading-relaxed.text-gray-600 利用しているサービスを選ぶと、アイコンの変更手順を確認できます。
  - if links.present?
    ul.divide-y.divide-gray-200.list-none.p-0.m-0
      - links.each do |link|
        li
          details.service-guide
            summary
              = render 'icons/service_icon', site_name: link.site_name
              span.flex-1
                span.service-name = link.site_name
                span.block.text-sm.font-normal.text-gray-500 変更手順を見る
              svg.h-5.w-5.shrink-0.text-gray-400 aria-hidden='true' fill='none' stroke='currentColor' viewBox='0 0 24 24'
                path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m9 5 7 7-7 7'
            .service-guide-content
              ol.list-decimal.space-y-2.pl-6.text-base.leading-relaxed.text-gray-700
                - link.guide_text.each_line do |line|
                  li = line
              = link_to "#{link.site_name}を開く",
                link.url,
                target: '_blank',
                rel: 'noopener noreferrer',
                class: 'service-link'
  - else
    p.text-base.text-gray-500 対応しているサービスはまだ登録されていません
