- set_meta_tags title: 'ウェルカム'
- set_meta_tags description: '文字入りアイコンを登録なしで作成・ダウンロードできます。'

.welcome-page
  .mx-auto.max-w-5xl.px-5.py-10.sm:px-8.sm:py-14
    section.hero-section
      = link_to root_path, class: 'hero-logo', aria: { label: '文字入りアイコンメーカー トップ' } do
        = image_tag 'logo.png', class: 'h-auto w-full', alt: '文字入りアイコンメーカー'

      .hero-heading
        p.hero-callout 登録なしですぐに使えます
        h1.hero-title
          span.block オンラインイベント用の
          span.block
            span.sm:whitespace-nowrap 文字入りアイコンを
            wbr
            span.sm:whitespace-nowrap かんたん作成

      .hero-grid
        .hero-copy
          p.hero-description
            | アイコンに「ラジオ参加」「離席中」などの文字を追加すれば、声を出さなくても今の状況を伝えられます。画像を選ぶだけで、すぐに作成・ダウンロードできます。

          - if current_user
            .mt-8
              = link_to 'アイコンに文字を合成する', new_icon_path, class: 'primary-cta'

        .hero-visual aria-label='文字を追加する前と後のアイコン例'
          .example-card
            p.example-label 文字を追加する前
            .avatar-example
              svg aria-hidden='true' fill='none' viewBox='0 0 120 120'
                circle cx='60' cy='43' r='24' fill='currentColor'
                path d='M20 112c3-29 19-45 40-45s37 16 40 45' fill='currentColor'
          svg.example-arrow aria-hidden='true' fill='none' stroke='currentColor' viewBox='0 0 24 24'
            path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m8 5 7 7-7 7'
          .example-card.example-card--after
            p.example-label 文字を追加した後
            .avatar-example
              svg aria-hidden='true' fill='none' viewBox='0 0 120 120'
                circle cx='60' cy='43' r='24' fill='currentColor'
                path d='M20 112c3-29 19-45 40-45s37 16 40 45' fill='currentColor'
              span.avatar-overlay ラジオ参加

    - unless current_user
      section.start-options-section aria-labelledby='start-options-title'
        h2#start-options-title.text-2xl.font-bold.text-gray-900 どちらの方法で始めますか？
        .start-options-actions
          = button_to 'Googleアカウントでログイン', '/auth/google_oauth2',
            method: :post,
            data: { turbo: false },
            class: 'primary-cta w-full',
            form_class: 'w-full sm:w-80'
          = link_to 'ログインせずに始める', new_icon_path, class: 'secondary-cta w-full sm:w-80'

    section.mt-16.sm:mt-24 aria-labelledby='benefits-title'
      .max-w-2xl
        p.step-label 使い方を選べます
        h2#benefits-title.text-3xl.font-bold.leading-snug.text-gray-900 登録なしでも、ログインしても便利
        p.mt-3.text-base.leading-relaxed.text-gray-600 まず試したい方も、作ったアイコンを残したい方も、自分に合った方法で始められます。

      .mt-8.grid.gap-6.md:grid-cols-2
        article.benefit-card.benefit-card--primary
          .benefit-illustration aria-hidden='true'
            svg fill='none' stroke='currentColor' viewBox='0 0 24 24'
              path stroke-linecap='round' stroke-linejoin='round' stroke-width='1.8' d='M12 3v12m0 0 4-4m-4 4-4-4M5 20h14'
          div
            h3 登録なしで作成・ダウンロード
            p 画像を選んで文字を追加するだけ。アカウントを作らず、今すぐ利用できます。
        article.benefit-card
          .benefit-illustration aria-hidden='true'
            svg fill='none' stroke='currentColor' viewBox='0 0 24 24'
              path stroke-linecap='round' stroke-linejoin='round' stroke-width='1.8' d='M5 5h14v14H5zM8 5v6h8V5M8 19v-5h8v5'
          div
            h3 ログインでもっと便利に
            p Googleアカウントでログインすると、作ったアイコンをサイトに保存して、あとから確認できます。
