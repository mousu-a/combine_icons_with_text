header.header
  div(class='flex items-center border-b-gray bg-white px-4 py-2 sm:px-6')
    div(class='flex items-center justify-between w-full' data-controller='dropdown')
      = link_to image_tag('logo.png', class: 'h-14 w-auto rounded-md', alt: '文字入りアイコンメーカー'), root_path
      - if current_user
        .flex.items-center.gap-3
          = button_tag type: 'button', class: 'min-h-11 min-w-11 cursor-pointer', data: { dropdown_target: 'avatarIcon', action: 'click->dropdown#toggleLogoutButton' } do
            = image_tag current_user.avatar_url, alt: 'アカウントメニューを開く', id: 'avatar-icon', class: 'w-11 h-11 rounded-full'
          = link_to 'ログアウト', logout_path,
            data: { turbo_method: :delete, dropdown_target: 'logoutButton' },
            class: 'logout hidden min-h-11 items-center text-base font-medium text-gray-700 hover:text-gray-900'
