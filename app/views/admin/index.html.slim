- set_meta_tags title: '管理画面'

- if current_user.admin?
  ruby:
    label_class = 'block text-base font-medium text-gray-800 mb-1'
    input_class = 'text-input'
    button_class = 'secondary-button'
    page_actions = [{ label: 'アイコンに文字合成画面へ', path: new_icon_path }, { label: '一覧画面へ', path: icons_path }]

  = render 'layouts/page_header', title: '管理画面', actions: page_actions

  .mx-auto.max-w-5xl.rounded-md.px-6.py-6
    .grid.gap-10.lg:grid-cols-2
      section
        h2.section-title
          | 文字を追加する
        = form_with model: [:admin, @overlay_text], class: 'flex items-end gap-2 mb-4' do |f|
          .flex-1
            = render 'layouts/errors', object: @overlay_text
            = f.label :text, class: label_class
            = f.text_field :text, class: input_class
          = f.submit '追加', class: "shrink-0 #{button_class}"

        - if @overlay_texts.any?
          ul.list-disc.space-y-1.pl-5.text-base.text-gray-700
            - @overlay_texts.each do |overlay_text|
              li = overlay_text.text
        - else
          p.text-base.text-gray-500
            | 追加された文字はまだありません

      section
        h2.section-title
          | リンクを追加する
        = form_with model: [:admin, @icon_change_link], class: 'space-y-2 mb-4' do |f|
          = render 'layouts/errors', object: @icon_change_link
          .grid.gap-2.sm:grid-cols-2
            div
              = f.label :site_name, class: label_class
              = f.text_field :site_name, class: input_class
            div
              = f.label :url, class: label_class
              = f.text_field :url, class: input_class
          = f.label :guide_text, class: label_class
          = f.text_area :guide_text, rows: 2, class: input_class
          = f.submit '追加', class: button_class

    = render 'icons/icon_change_links', links: @icon_change_links
